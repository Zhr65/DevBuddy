# DevBuddy agent 环境变量模板
# 用法：复制一份改名为 .env，再填入真实值
#   PowerShell:  Copy-Item .env.example .env
#   Git Bash:    cp .env.example .env
# .env 已在 .gitignore 里，不会被提交；这个模板本身要提交。

# ---------- 密钥（必填）----------
# 聊天模型（apihub）
AGNES_API_KEY=

# 向量模型（硅基流动）—— https://cloud.siliconflow.cn 控制台「API 密钥」页新建
SILICONFLOW_API_KEY=

# ---------- 检索参数（可选，不填走默认）----------
# 每次检索取几块喂给 LLM
TOP_K=5

# 相似度阈值：低于它的块直接丢弃（兜底防幻觉）
# 0.5 是实测断层中点：无关 query 余弦上限 0.4717 / 相关 query 余弦下限 0.6940
# 做阈值实验时只改这一行，不用动代码（改完需重启进程，config 在 import 时求值）
SCORE_THRESHOLD=0.5

# ---------- 路径（可选）----------
# 自托管 BGE-M3 权重目录（约 2.2GB）。不填则用默认值 D:\AI\store\models\bge-m3
# BGE_M3_LOCAL_PATH=D:\AI\store\models\bge-m3
